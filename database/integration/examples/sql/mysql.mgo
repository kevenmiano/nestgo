package sqlsample

import "context"

// MySQL uses ? placeholders in generated SQL.
@Entity({table: "nestgo_sql_example_users"})
type MySQLUser struct {
	ID int64
	Name string
}

@Repository(MySQLUser, "billing")
type MySQLUsersRepository struct{}

@Query("INSERT INTO nestgo_sql_example_users (id, name) VALUES (:id, :name)")
func (r *MySQLUsersRepository) Insert(ctx context.Context, id int64, name string) (int64, error) { return 0, nil }

@Query("SELECT name, id FROM nestgo_sql_example_users WHERE id = :id")
func (r *MySQLUsersRepository) FindByID(ctx context.Context, id int64) (*MySQLUser, error) { return nil, nil }

@Query("SELECT id, name FROM nestgo_sql_example_users ORDER BY id")
func (r *MySQLUsersRepository) FindAll(ctx context.Context) ([]MySQLUser, error) { return nil, nil }

@Query("UPDATE nestgo_sql_example_users SET name = :name WHERE id = :id")
func (r *MySQLUsersRepository) UpdateName(ctx context.Context, name string, id int64) (int64, error) { return 0, nil }

@Query("DELETE FROM nestgo_sql_example_users WHERE id = :id")
func (r *MySQLUsersRepository) Delete(ctx context.Context, id int64) (int64, error) { return 0, nil }
