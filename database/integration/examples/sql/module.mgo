package sqlsample

import (
	"context"
	"strconv"
)

// The generated repositories satisfy ordinary Go interfaces. Depending on
// the interfaces avoids referencing code that does not exist until compilation.
type PostgresUserReader interface {
	FindByID(ctx context.Context, id int64) (*PostgresUser, error)
}

type MySQLUserReader interface {
	FindByID(ctx context.Context, id int64) (*MySQLUser, error)
}

// NestGo injects the generated concrete implementations through these contracts.
@Injectable()
type SQLUsersService struct {
	Postgres PostgresUserReader `nestgo:"inject"`
	MySQL MySQLUserReader `nestgo:"inject"`
}

func (s *SQLUsersService) FindPostgres(id int64) (*PostgresUser, error) {
	return s.Postgres.FindByID(context.Background(), id)
}

func (s *SQLUsersService) FindMySQL(id int64) (*MySQLUser, error) {
	return s.MySQL.FindByID(context.Background(), id)
}

@Controller("/sql-users")
type SQLUsersController struct {
	Service *SQLUsersService `nestgo:"inject"`
}

@Get("/postgres/{id}")
func (c *SQLUsersController) GetPostgres(@Param("id") id string) (*PostgresUser, error) {
	parsed, err := strconv.ParseInt(id, 10, 64)
	if err != nil { return nil, err }
	return c.Service.FindPostgres(parsed)
}

@Get("/mysql/{id}")
func (c *SQLUsersController) GetMySQL(@Param("id") id string) (*MySQLUser, error) {
	parsed, err := strconv.ParseInt(id, 10, 64)
	if err != nil { return nil, err }
	return c.Service.FindMySQL(parsed)
}

@Module({controllers: [SQLUsersController], providers: [SQLUsersService]})
type SQLModule struct{}
